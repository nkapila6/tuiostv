{
  "manifest_version": 3,
  "name": "tuios-pip",
  "version": "0.1.0",
  "description": "Share the playing video with a tuios pane over loopback.",
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "tuios-pip@nkapila6",
      "strict_min_version": "128.0"
    }
  }
}
